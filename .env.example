# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Database Configuration
# True — локальная SQLite (smena_db.sqlite), False — PostgreSQL с настройками ниже
USE_SQLITE=True
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smena_db
DB_USER=postgres
DB_PASSWORD=your_password

# Admin Panel Configuration
ADMIN_SECRET_KEY=your_secret_key_here
ADMIN_HOST=0.0.0.0
ADMIN_PORT=5000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Payments (для будущей интеграции)
PAYMENT_TOKEN=your_payment_token

# Application Settings
DEBUG=True
TIMEZONE=Europe/Moscow

# Commission Settings (комиссия считается в процентах, см. config/settings.py)
PREPAYMENT_PERCENT=50

# Папка с картинками для профилей (smena_profile_1280x720.png и т.п.)
# ASSETS_DIR=C:\path\to\smenaassets

# ==== Добавлено 27.11.2026 (все параметры необязательны, ниже значения по умолчанию) ====
# Другой файл SQLite (например, копия базы для проверки); по умолчанию smena_db.sqlite
# SQLITE_PATH=D:\smenadev-main\smena_db.sqlite

# Отметка «я на месте»: за сколько минут до начала прислать кнопку, сколько минут опоздания допустимо,
# дальше какого расстояния от точки заказа отметка помечается «далеко»
# CHECKIN_PROMPT_MINUTES=30
# CHECKIN_GRACE_MINUTES=15
# CHECKIN_MAX_DISTANCE_M=500

# Надёжность: сколько дней действуют штрафные баллы, с какого числа баллов работник не получает вакансии,
# через сколько минут вакансия уходит остальным после надёжных работников (0 — всем сразу)
# PENALTY_WINDOW_DAYS=90
# PENALTY_RESTRICT_POINTS=10
# PRIORITY_DELAY_MINUTES=15

# Реферальная программа: бонус пригласившему, ₽
# REFERRAL_BONUS=300
